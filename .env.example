# Cashfree environment: sandbox for testing, production for live payments
CASHFREE_ENV=sandbox

# Put these ONLY in Render Environment Variables.
# Never commit real credentials to GitHub.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Cashfree API version
CASHFREE_API_VERSION=2025-01-01

# After Render gives you a URL, put it here, for example:
# https://hr-ride.onrender.com
PUBLIC_BASE_URL=
